        "responseBody": "={{ { type: 'decision_required', id: 'reuse_existing_plan', step: 'plan_check', url: $('Webhook').item.json.body.url, question: 'A saved plan exists for this URL. Reuse it or discover the route again?', options: ['reuse', 'rediscover'], context: { plan: $json.body.plan } } }}",
        "options": {}
      },
      "id": "04db7ad0-5b85-4e6c-808a-240882fcfae0",
